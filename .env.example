# Reference only. Run `pnpm exec eve link` for each new Vercel project,
# provision its integrations, then `pnpm exec vercel env pull .env.local`.
# Do not copy another project's .env.local or .vercel directory.

# Vercel Connect connector UIDs, not provider API keys.
# Replace these examples with the UIDs provisioned for your new project.
NOTION_CONNECTOR=notion/your-project
RESEND_CONNECTOR=resend/your-project
SLACK_CONNECTOR=slack/your-project

# Gateway, Sandbox and Blob credentials are supplied by the linked project.
# Keep generated credentials in .env.local, which is ignored by Git.
# Optional Gateway API-key authentication, if configured for your project:
# AI_GATEWAY_API_KEY=
